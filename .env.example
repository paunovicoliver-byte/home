# Canonical origin used for canonicals, hreflang, sitemap and Open Graph.
SITE_URL=https://www.drveno.com

# Google Tag Manager container (optional). Leave empty to disable GTM.
PUBLIC_GTM_ID=

# Consent strategy: "basic" (GTM loads only after analytics/marketing consent)
# or "advanced" (GTM loads immediately with Google Consent Mode defaults = denied).
PUBLIC_CONSENT_MODE=basic

# Form handling. Leave empty to use Netlify Forms (works out of the box on Netlify).
# Set to an HTTPS endpoint (e.g. your own API or a form service) that accepts
# multipart/form-data POSTs and answers 2xx on success.
PUBLIC_FORM_ENDPOINT=
