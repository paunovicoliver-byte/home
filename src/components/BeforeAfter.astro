---
import Img from './Img.astro';
import type { ImageMetadata } from 'astro';
import { t } from '../i18n/ui';
import type { Locale } from '../i18n/config';
interface Props { locale: Locale; id: string; before: { src: ImageMetadata; alt: string }; after: { src: ImageMetadata; alt: string } }
const { locale, id, before, after } = Astro.props;
const p = t(locale).project;
---
<figure class="ba" data-before-after={id} style="--pos: 50%">
  <div class="ba__frame media media--4x3">
    <div class="ba__img ba__after"><Img src={after.src} alt={after.alt} ratio={4 / 3} sizes="(min-width: 1100px) 66vw, 92vw" /></div>
    <div class="ba__img ba__before"><Img src={before.src} alt={before.alt} ratio={4 / 3} sizes="(min-width: 1100px) 66vw, 92vw" /></div>
    <div class="ba__handle" aria-hidden="true"><span></span></div>
    <span class="ba__tag ba__tag--before" aria-hidden="true">{p.before}</span>
    <span class="ba__tag ba__tag--after" aria-hidden="true">{p.after}</span>
    <label class="visually-hidden" for={`${id}-range`}>{p.sliderLabel}</label>
    <input class="ba__range" id={`${id}-range`} type="range" min="0" max="100" value="50" step="1" aria-valuetext="50%" />
  </div>
  <figcaption class="caption">{p.before} / {p.after}</figcaption>
</figure>
<script>
  document.querySelectorAll<HTMLInputElement>('.ba__range').forEach((r) =>
    r.addEventListener('input', () => r.setAttribute('aria-valuetext', `${r.value}%`)),
  );
</script>
<style>
  .ba__frame { position: relative; touch-action: pan-y; }
  .ba__img { position: absolute; inset: 0; }
  .ba__img :global(picture), .ba__img :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .ba__before { clip-path: inset(0 calc(100% - var(--pos)) 0 0); }
  .ba__handle { position: absolute; top: 0; bottom: 0; left: var(--pos); width: 2px; margin-left: -1px; background: #fff; pointer-events: none; }
  .ba__handle span { position: absolute; top: 50%; left: 50%; width: 44px; height: 44px; margin: -22px; border-radius: 50%; background: #fff; box-shadow: 0 2px 10px rgb(0 0 0 / 0.25); }
  .ba__handle span::before, .ba__handle span::after { content: ''; position: absolute; top: 50%; width: 8px; height: 8px; border: solid var(--ink); border-width: 0 0 1.5px 1.5px; margin-top: -4px; }
  .ba__handle span::before { left: 11px; transform: rotate(45deg); }
  .ba__handle span::after { right: 11px; transform: rotate(-135deg); }
  .ba__tag { position: absolute; top: 12px; padding: 4px 10px; background: rgb(28 26 23 / 0.7); color: #fff; font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; pointer-events: none; }
  .ba__tag--before { left: 12px; }
  .ba__tag--after { right: 12px; }
  .ba__range { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: ew-resize; -webkit-appearance: none; appearance: none; }
  .ba__frame:has(.ba__range:focus-visible) .ba__handle span { outline: 2px solid var(--focus); outline-offset: 2px; }
</style>
