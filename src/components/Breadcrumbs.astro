---
import { t } from '../i18n/ui';
import type { Locale } from '../i18n/config';
interface Props { locale: Locale; items: { name: string; href: string }[] }
const { locale, items } = Astro.props;
---
<nav class="crumbs container" aria-label={t(locale).a11y.breadcrumbs}>
  <ol>
    {items.map((it, i) => (
      <li>{i < items.length - 1 ? <a href={it.href}>{it.name}</a> : <span aria-current="page">{it.name}</span>}</li>
    ))}
  </ol>
</nav>
<style>
  .crumbs { padding-top: 18px; font-size: 0.8125rem; color: var(--muted); }
  .crumbs ol { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 4px 0; }
  .crumbs li { display: flex; align-items: center; }
  .crumbs li + li::before { content: '/'; padding-inline: 8px; opacity: 0.6; }
  .crumbs a { text-decoration: none; padding-block: 6px; }
  .crumbs a:hover { text-decoration: underline; }
  .crumbs span[aria-current] { color: var(--ink-2); }
</style>
