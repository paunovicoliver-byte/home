---
import { t } from '../i18n/ui';
import { path } from '../i18n/routes';
import type { Locale } from '../i18n/config';
import Icon from './Icon.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const c = t(locale).consent;
---
<section class="consent" data-consent-banner aria-labelledby="consent-title" role="region">
  <div class="consent__inner">
    <h2 id="consent-title" class="consent__title">{c.title}</h2>
    <p class="consent__text">{c.text} <a href={path(locale, 'privacy')}>{c.privacyLink}</a></p>
    <div class="consent__actions">
      <button type="button" class="btn" data-consent-action="accept">{c.acceptAll}</button>
      <button type="button" class="btn btn--ghost" data-consent-action="reject">{c.rejectAll}</button>
      <button type="button" class="btn btn--ghost" data-consent-open>{c.customize}</button>
    </div>
  </div>
</section>

<dialog class="consent-dialog" data-consent-dialog aria-labelledby="consent-dialog-title">
  <form method="dialog" class="consent-dialog__form" data-consent-form>
    <div class="consent-dialog__head">
      <h2 id="consent-dialog-title" class="h3">{c.settingsTitle}</h2>
      <button type="button" class="consent-dialog__close" data-consent-close>
        <Icon name="close" size={22} /><span class="visually-hidden">{c.close}</span>
      </button>
    </div>
    <p class="consent-dialog__intro">{c.text}</p>
    <ul class="consent-dialog__list">
      <li>
        <div class="consent-row">
          <div>
            <p class="consent-row__title" id="cc-essential">{c.essential}</p>
            <p class="consent-row__text">{c.essentialText}</p>
          </div>
          <span class="consent-row__fixed">{c.alwaysOn}</span>
        </div>
      </li>
      <li>
        <label class="consent-row">
          <span>
            <span class="consent-row__title">{c.analytics}</span>
            <span class="consent-row__text">{c.analyticsText}</span>
          </span>
          <input type="checkbox" class="switch" name="analytics" />
        </label>
      </li>
      <li>
        <label class="consent-row">
          <span>
            <span class="consent-row__title">{c.marketing}</span>
            <span class="consent-row__text">{c.marketingText}</span>
          </span>
          <input type="checkbox" class="switch" name="marketing" />
        </label>
      </li>
    </ul>
    <div class="consent-dialog__actions">
      <button type="submit" class="btn" value="save" data-consent-action="save">{c.save}</button>
      <button type="button" class="btn btn--ghost" data-consent-action="accept">{c.acceptAll}</button>
      <button type="button" class="btn btn--ghost" data-consent-action="reject">{c.rejectAll}</button>
    </div>
    <p class="visually-hidden" role="status" data-consent-status data-saved-text={c.saved}></p>
  </form>
</dialog>

<style>
  .consent {
    display: none;
    position: fixed; z-index: 50; left: 0; right: 0; bottom: 0;
    padding: 0 0 env(safe-area-inset-bottom);
  }
  :global(html.js:not([data-consent='set'])) .consent { display: block; }
  .consent__inner {
    margin: 0 auto; max-width: 1100px; background: var(--paper); border-top: 1px solid var(--line-strong);
    padding: 20px var(--gutter) 20px; box-shadow: 0 -12px 40px rgb(28 26 23 / 0.10);
    display: grid; gap: 12px;
  }
  @media (min-width: 720px) {
    .consent { left: 16px; right: 16px; bottom: 16px; }
    .consent__inner { border: 1px solid var(--line-strong); padding: 24px 28px; grid-template-columns: 1fr auto; align-items: end; column-gap: 32px; }
    .consent__title, .consent__text { grid-column: 1; }
    .consent__actions { grid-column: 2; grid-row: 1 / span 2; }
  }
  .consent__title { font-size: var(--step-1); font-family: var(--serif); font-size: 1.5rem; }
  .consent__text { font-size: 0.875rem; color: var(--ink-2); max-width: 60em; line-height: 1.55; }
  .consent__actions { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .consent__actions .btn { min-height: 46px; padding: 0.5rem 1rem; font-size: 0.875rem; }
  .consent__actions .btn:last-child { grid-column: 1 / -1; }
  @media (min-width: 720px) { .consent__actions { grid-template-columns: auto auto auto; } .consent__actions .btn:last-child { grid-column: auto; } }

  .consent-dialog {
    width: min(640px, calc(100% - 24px)); max-height: calc(100% - 24px); padding: 0; border: 1px solid var(--line-strong);
    background: var(--paper); color: var(--ink);
  }
  .consent-dialog::backdrop { background: rgb(28 26 23 / 0.5); }
  .consent-dialog__form { padding: clamp(20px, 4vw, 36px); display: grid; gap: 18px; }
  .consent-dialog__head { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .consent-dialog__close { width: 44px; height: 44px; display: grid; place-items: center; background: none; border: 0; cursor: pointer; margin-right: -10px; }
  .consent-dialog__intro { font-size: 0.875rem; color: var(--ink-2); }
  .consent-dialog__list { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--line); }
  .consent-dialog__list li { border-bottom: 1px solid var(--line); }
  .consent-row { display: flex; gap: 16px; justify-content: space-between; align-items: center; padding-block: 16px; cursor: pointer; }
  .consent-row > :first-child { display: grid; gap: 4px; }
  .consent-row__title { font-weight: 560; display: block; }
  .consent-row__text { font-size: 0.875rem; color: var(--muted); display: block; }
  .consent-row__fixed { font-size: 0.8125rem; color: var(--muted); white-space: nowrap; }
  .switch {
    appearance: none; flex: none; width: 48px; height: 28px; border-radius: 14px; margin: 0;
    background: var(--paper-3); border: 1px solid var(--line-strong); position: relative; cursor: pointer;
    transition: background-color 0.2s;
  }
  .switch::after { content: ''; position: absolute; top: 3px; left: 3px; width: 20px; height: 20px; border-radius: 50%; background: #fff; box-shadow: 0 1px 2px rgb(0 0 0 / 0.25); transition: transform 0.2s var(--ease); }
  .switch:checked { background: var(--forest); border-color: var(--forest); }
  .switch:checked::after { transform: translateX(20px); }
  .consent-dialog__actions { display: flex; flex-wrap: wrap; gap: 8px; }
  .consent-dialog__actions .btn { flex: 1 1 auto; min-height: 46px; font-size: 0.875rem; }
</style>
