---
/** The closing invitation used across the site. */
import Icon from './Icon.astro';
import { t } from '../i18n/ui';
import { path } from '../i18n/routes';
import type { Locale } from '../i18n/config';
interface Props { locale: Locale; title?: string; lines?: string[]; text?: string; cta?: string; href?: string; location?: string; projectType?: string }
const { locale, location = 'closing', projectType } = Astro.props;
const tt = t(locale);
const title = Astro.props.title ?? tt.closing.title;
const lines = Astro.props.lines ?? (Astro.props.text ? [Astro.props.text] : tt.closing.lines);
const cta = Astro.props.cta ?? tt.cta.tellBuild;
const href = Astro.props.href ?? path(locale, 'start') + (projectType ? `?type=${projectType}` : '');
---
<section class="cta-band on-dark" aria-labelledby={`cta-${location}`}>
  <div class="container cta-band__inner reveal">
    <h2 class="h1" id={`cta-${location}`}>{title}</h2>
    <div class="cta-band__body">
      {lines.map((l) => <p class="lead">{l}</p>)}
      <div class="btn-row">
        <a class="btn btn--light" href={href} data-track="start_project" data-track-location={location}>{cta}<Icon name="arrow" class="arrow" /></a>
      </div>
      <p class="regions muted">{tt.brand.regions}</p>
    </div>
  </div>
</section>
<style>
  .cta-band { padding-block: var(--space-section); background: var(--forest); }
  .cta-band__inner { display: grid; gap: 32px; }
  @media (min-width: 960px) { .cta-band__inner { grid-template-columns: 1.1fr 1fr; align-items: end; gap: 80px; } }
  .cta-band__body { display: grid; gap: 14px; }
  .cta-band__body .btn-row { margin-top: 18px; }
  .cta-band__body .regions { margin-top: 18px; }
  .cta-band h2 { max-width: 12ch; }
</style>
