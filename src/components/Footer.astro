---
import LangSwitch from './LangSwitch.astro';
import { t } from '../i18n/ui';
import { path, type RouteKey } from '../i18n/routes';
import type { Locale } from '../i18n/config';
import type { Alternates } from '../lib/pages';
import { site } from '../config/site';

interface Props { locale: Locale; alternates: Alternates }
const { locale, alternates } = Astro.props;
const tt = t(locale);
const explore: RouteKey[] = ['work', 'windows', 'heritage', 'projects', 'journal'];
const atelier: RouteKey[] = ['story', 'process', 'switzerland', 'start', 'contact'];
const year = new Date().getFullYear();
---
<footer class="site-footer on-dark">
  <div class="container">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <a class="site-footer__logo" href={path(locale, 'home')} aria-label={tt.brand.homeLabel}>DRVENO</a>
        <p class="site-footer__tagline">{tt.brand.tagline}</p>
        <p class="site-footer__statement">{tt.footer.statement}</p>
      </div>
      <nav class="site-footer__cols" aria-label={tt.a11y.footerNav}>
        <div>
          <h2 class="site-footer__h">{tt.footer.explore}</h2>
          <ul>{explore.map((k) => <li><a href={path(locale, k)}>{tt.nav[k]}</a></li>)}</ul>
        </div>
        <div>
          <h2 class="site-footer__h">{tt.footer.atelier}</h2>
          <ul>{atelier.map((k) => <li><a href={path(locale, k)}>{tt.nav[k]}</a></li>)}</ul>
        </div>
        <div>
          <h2 class="site-footer__h">{tt.footer.contact}</h2>
          <ul>
            <li><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></li>
            <li><span class="site-footer__label">{tt.footer.workshop}</span><a href={`tel:${site.contact.phoneHref}`}>{site.contact.phone}</a></li>
            <li><span class="site-footer__label">{tt.footer.swiss}</span><a href={`tel:${site.contact.switzerland.phoneHref}`}>{site.contact.switzerland.phone}</a></li>
            <li><a href={`https://wa.me/${site.contact.whatsapp}`} rel="noopener" target="_blank">WhatsApp<span class="visually-hidden"> ({tt.a11y.newWindow})</span></a></li>
          </ul>
        </div>
      </nav>
    </div>
    <div class="site-footer__bottom">
      <p class="regions">{tt.brand.regions}</p>
      <LangSwitch locale={locale} alternates={alternates} variant="footer" />
      <ul class="site-footer__legal">
        <li><button type="button" class="linklike" data-consent-open>{tt.footer.cookieSettings}</button></li>
        <li><a href={path(locale, 'privacy')}>{tt.nav.privacy}</a></li>
        <li><a href={path(locale, 'imprint')}>{tt.nav.imprint}</a></li>
        <li>© {year} {site.name}. {tt.footer.rights}</li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer { padding-block: clamp(64px, 9vw, 120px) max(32px, env(safe-area-inset-bottom)); }
  .site-footer a { text-decoration: none; }
  .site-footer a:hover { text-decoration: underline; }
  .site-footer__top { display: grid; gap: 48px; padding-bottom: 48px; border-bottom: 1px solid rgb(241 236 226 / 0.18); }
  @media (min-width: 960px) { .site-footer__top { grid-template-columns: 1fr 1.6fr; gap: 64px; } }
  .site-footer__logo { font-family: var(--serif); font-size: 1.75rem; letter-spacing: 0.22em; }
  .site-footer__tagline { font-family: var(--serif); font-style: italic; font-size: var(--step-2); margin-top: 0.6rem; }
  .site-footer__statement { color: var(--on-dark-muted); margin-top: 1rem; max-width: 30em; }
  .site-footer__cols { display: grid; gap: 32px; grid-template-columns: 1fr 1fr; }
  .site-footer__cols > div:last-child { grid-column: 1 / -1; }
  @media (min-width: 720px) { .site-footer__cols { grid-template-columns: repeat(3, 1fr); } .site-footer__cols > div:last-child { grid-column: auto; } }
  .site-footer__h { font-family: var(--sans); font-size: 0.75rem; font-weight: 560; letter-spacing: 0.16em; text-transform: uppercase; color: var(--on-dark-muted); margin-bottom: 0.9rem; }
  .site-footer__cols ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 2px; }
  .site-footer__cols a { display: inline-block; padding-block: 7px; overflow-wrap: anywhere; }
  .site-footer__label { display: block; font-size: 0.8125rem; color: var(--on-dark-muted); margin-top: 6px; }
  .site-footer__bottom { display: grid; gap: 16px; padding-top: 28px; font-size: 0.875rem; color: var(--on-dark-muted); }
  @media (min-width: 960px) { .site-footer__bottom { grid-template-columns: auto auto 1fr; align-items: center; gap: 32px; } }
  .site-footer__legal { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 4px 20px; }
  @media (min-width: 960px) { .site-footer__legal { justify-content: flex-end; } }
  .site-footer__legal a, .linklike { display: inline-block; padding-block: 8px; }
  .linklike { background: none; border: 0; padding-inline: 0; cursor: pointer; font-size: inherit; color: inherit; text-decoration: underline; text-underline-offset: 0.2em; }
</style>
