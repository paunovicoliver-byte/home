---
import Img from './Img.astro';
import Icon from './Icon.astro';
import type { ImageMetadata } from 'astro';
import { t, fmt } from '../i18n/ui';
import type { Locale } from '../i18n/config';
interface Props { locale: Locale; id: string; images: { src: ImageMetadata; alt: string }[]; label: string }
const { locale, id, images, label } = Astro.props;
const g = t(locale).gallery;
---
<div class="gallery" data-gallery={id} role="region" aria-roledescription="carousel" aria-label={label}>
  <ul class="gallery__track" data-gallery-track tabindex="0">
    {images.map((im, i) => (
      <li class="gallery__slide" aria-roledescription="slide" aria-label={fmt(g.position, { current: i + 1, total: images.length })}>
        <div class="media media--4x3"><Img src={im.src} alt={im.alt} ratio={4 / 3} sizes="(min-width: 1100px) 66vw, 88vw" /></div>
      </li>
    ))}
  </ul>
  {images.length > 1 && (
    <div class="gallery__controls">
      <p class="gallery__pos" data-gallery-pos data-template={fmt(g.position, { current: '{current}', total: '{total}' })} aria-live="polite">{fmt(g.position, { current: 1, total: images.length })}</p>
      <div class="gallery__btns">
        <button type="button" class="gallery__btn" data-gallery-prev disabled><Icon name="prev" size={22} /><span class="visually-hidden">{g.previous}</span></button>
        <button type="button" class="gallery__btn" data-gallery-next><Icon name="next" size={22} /><span class="visually-hidden">{g.next}</span></button>
      </div>
    </div>
  )}
</div>
<style>
  .gallery__track {
    list-style: none; margin: 0; padding: 0; display: grid; grid-auto-flow: column; grid-auto-columns: 88%;
    gap: 12px; overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-x: contain;
    scrollbar-width: none; -webkit-overflow-scrolling: touch;
  }
  .gallery__track::-webkit-scrollbar { display: none; }
  @media (min-width: 900px) { .gallery__track { grid-auto-columns: 66%; gap: 20px; } }
  .gallery__slide { scroll-snap-align: start; }
  .gallery__controls { display: flex; justify-content: space-between; align-items: center; margin-top: 14px; }
  .gallery__pos { font-size: 0.875rem; color: var(--muted); }
  .gallery__btns { display: flex; gap: 8px; }
  .gallery__btn { width: 48px; height: 48px; display: grid; place-items: center; border: 1px solid var(--line-strong); background: transparent; cursor: pointer; }
  .gallery__btn:hover:not(:disabled) { background: var(--ink); color: var(--paper); }
  .gallery__btn:disabled { opacity: 0.35; cursor: default; }
</style>
