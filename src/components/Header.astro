---
import LangSwitch from './LangSwitch.astro';
import Icon from './Icon.astro';
import { t } from '../i18n/ui';
import { path, type RouteKey } from '../i18n/routes';
import type { Locale } from '../i18n/config';
import type { Alternates } from '../lib/pages';
import { site } from '../config/site';

interface Props { locale: Locale; alternates: Alternates; current?: RouteKey; overlay?: boolean }
const { locale, alternates, current, overlay = false } = Astro.props;
const tt = t(locale);
const items: RouteKey[] = ['work', 'windows', 'heritage', 'story', 'projects', 'journal', 'contact'];
const secondary: RouteKey[] = ['process', 'switzerland'];
---
<header class:list={['site-header', { 'site-header--overlay': overlay }]} data-header>
  <div class="container site-header__inner">
    <a class="logo" href={path(locale, 'home')} aria-label={tt.brand.homeLabel}>DRVENO</a>

    <nav class="nav-desktop" aria-label={tt.a11y.mainNav}>
      <ul>
        {items.map((k) => (
          <li><a href={path(locale, k)} aria-current={current === k ? 'page' : undefined}>{tt.nav[k]}</a></li>
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      <LangSwitch locale={locale} alternates={alternates} class="lang-header" />
      <a class="btn header-cta" href={path(locale, 'start')} data-track="start_project" data-track-location="header">{tt.nav.start}</a>
      <button class="menu-btn" type="button" aria-haspopup="dialog" aria-controls="site-menu" data-menu-open>
        <Icon name="menu" size={24} />
        <span class="visually-hidden">{tt.a11y.menuOpen}</span>
      </button>
    </div>
  </div>
</header>

<dialog id="site-menu" class="menu" aria-label={tt.a11y.mainNav}>
  <div class="menu__top container">
    <a class="logo" href={path(locale, 'home')} aria-label={tt.brand.homeLabel}>DRVENO</a>
    <button class="menu-btn" type="button" data-menu-close>
      <Icon name="close" size={24} />
      <span class="visually-hidden">{tt.a11y.menuClose}</span>
    </button>
  </div>
  <nav class="menu__body container" aria-label={tt.a11y.mainNav}>
    <ul class="menu__primary">
      <li><a href={path(locale, 'home')} aria-current={current === 'home' ? 'page' : undefined}>{tt.nav.home}</a></li>
      {items.map((k) => (
        <li><a href={path(locale, k)} aria-current={current === k ? 'page' : undefined}>{tt.nav[k]}</a></li>
      ))}
    </ul>
    <ul class="menu__secondary">
      {secondary.map((k) => <li><a href={path(locale, k)}>{tt.nav[k]}</a></li>)}
    </ul>
    <a class="btn btn--block" href={path(locale, 'start')} data-track="start_project" data-track-location="menu">{tt.cta.startProject}</a>
    <div class="menu__foot">
      <LangSwitch locale={locale} alternates={alternates} variant="menu" />
      <div class="menu__contact">
        <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
        <a href={`tel:${site.contact.phoneHref}`}>{site.contact.phone}</a>
      </div>
    </div>
  </nav>
</dialog>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 40;
    height: var(--header-h);
    background: rgb(244 239 230 / 0.94);
    backdrop-filter: saturate(1.2) blur(10px);
    -webkit-backdrop-filter: saturate(1.2) blur(10px);
    border-bottom: 1px solid var(--line);
    transition: background-color 0.35s var(--ease), color 0.35s var(--ease), border-color 0.35s var(--ease);
  }
  .site-header--overlay:not(.is-scrolled) {
    background: transparent; color: var(--on-dark); border-color: transparent;
    backdrop-filter: none; -webkit-backdrop-filter: none;
  }
  .site-header--overlay:not(.is-scrolled) :global(.btn.header-cta) { --btn-bg: transparent; --btn-fg: var(--on-dark); --btn-border: rgb(241 236 226 / 0.6); }
  .site-header--overlay:not(.is-scrolled) :global(.btn.header-cta:hover) { --btn-bg: var(--on-dark); --btn-fg: var(--ink); }
  .site-header__inner { height: 100%; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .logo {
    font-family: var(--serif); font-weight: 500; font-size: 1.375rem; letter-spacing: 0.22em;
    text-decoration: none; padding-block: 10px; margin-right: -0.22em; white-space: nowrap;
  }
  .nav-desktop { display: none; }
  .nav-desktop ul { display: flex; gap: clamp(14px, 1.6vw, 28px); list-style: none; margin: 0; padding: 0; }
  .nav-desktop a {
    font-size: 0.875rem; font-weight: 480; letter-spacing: 0.02em; text-decoration: none;
    padding-block: 10px; background: linear-gradient(currentColor, currentColor) 0 calc(100% - 4px) / 0 1px no-repeat;
    transition: background-size 0.35s var(--ease);
  }
  .nav-desktop a:hover, .nav-desktop a[aria-current='page'] { background-size: 100% 1px; }
  .site-header__actions { display: flex; align-items: center; gap: 6px; }
  .header-cta { display: none; min-height: 44px; padding: 0.55rem 1.1rem; font-size: 0.875rem; }
  .menu-btn {
    display: inline-grid; place-items: center; width: 48px; height: 48px; margin-right: -10px;
    background: none; border: 0; cursor: pointer;
  }
  :global(.lang-header) { display: none; }
  @media (min-width: 360px) { :global(.lang-header) { display: block; } }
  @media (min-width: 720px) { .header-cta { display: inline-flex; margin-left: 10px; } }
  @media (min-width: 1180px) {
    .nav-desktop { display: block; }
    .site-header__actions > .menu-btn { display: none; }
  }

  .menu {
    position: fixed; inset: 0; width: 100%; max-width: none; height: 100%; max-height: none;
    margin: 0; padding: 0 0 max(24px, env(safe-area-inset-bottom)); border: 0;
    background: var(--paper); color: var(--ink); overflow-y: auto; overscroll-behavior: contain;
  }
  .menu::backdrop { background: rgb(28 26 23 / 0.4); }
  .menu[open] { animation: menu-in 0.35s var(--ease); }
  @keyframes menu-in { from { opacity: 0; transform: translateY(-8px); } }
  @media (prefers-reduced-motion: reduce) { .menu[open] { animation: none; } }
  .menu__top { display: flex; align-items: center; justify-content: space-between; height: var(--header-h); border-bottom: 1px solid var(--line); }
  .menu__body { padding-top: 20px; display: grid; gap: 28px; }
  .menu__primary { list-style: none; padding: 0; margin: 0; }
  .menu__primary a {
    display: block; padding-block: 8px; font-family: var(--serif); font-size: clamp(1.9rem, 8vw, 2.6rem);
    line-height: 1.15; text-decoration: none;
  }
  .menu__primary a[aria-current='page'] { font-style: italic; }
  .menu__secondary { list-style: none; padding: 0; margin: 0; display: grid; gap: 4px; }
  .menu__secondary a { display: inline-block; padding-block: 10px; font-size: 1rem; }
  .menu__foot { display: grid; gap: 16px; border-top: 1px solid var(--line); padding-top: 18px; }
  .menu__contact { display: grid; gap: 2px; }
  .menu__contact a { padding-block: 10px; font-size: 0.9375rem; }
</style>
