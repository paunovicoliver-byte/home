---
/**
 * Responsive image: AVIF + WebP sources with srcset/sizes, JPEG fallback,
 * intrinsic width/height (no CLS). Lazy by default; `priority` for the LCP image.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes?: string;
  widths?: number[];
  priority?: boolean;
  class?: string;
  /** Crop to an aspect ratio (w/h), e.g. 4/5. Keeps intrinsic dimensions consistent. */
  ratio?: number;
}
const { src, alt, sizes = '100vw', priority = false, class: cls, ratio } = Astro.props;
const all = [400, 640, 960, 1280, 1600, 2400];
const widths = (Astro.props.widths ?? all).filter((w) => w <= src.width);
const width = Math.min(src.width, 2400);
const height = ratio ? Math.round(width / ratio) : Math.round((src.height / src.width) * width);
---
<Picture
  src={src}
  alt={alt}
  formats={['avif', 'webp']}
  fallbackFormat="jpg"
  widths={widths}
  sizes={sizes}
  width={width}
  height={height}
  quality={70}
  fit="cover"
  loading={priority ? 'eager' : 'lazy'}
  decoding={priority ? 'sync' : 'async'}
  fetchpriority={priority ? 'high' : 'auto'}
  class={cls}
/>
