---
import Icon from './Icon.astro';
import { t } from '../i18n/ui';
import { path } from '../i18n/routes';
import type { Locale } from '../i18n/config';
import { site } from '../config/site';
interface Props { locale: Locale }
const { locale } = Astro.props;
const tt = t(locale);
---
<div class="mobile-cta" data-mobile-cta aria-hidden="true">
  <a class="btn mobile-cta__main" href={path(locale, 'start')} data-track="start_project" data-track-location="mobile_bar" tabindex="-1">{tt.cta.startProject}</a>
  <a class="mobile-cta__icon" href={`https://wa.me/${site.contact.whatsapp}`} rel="noopener" target="_blank" tabindex="-1">
    <Icon name="whatsapp" size={22} /><span class="visually-hidden">{tt.cta.whatsapp}</span>
  </a>
  <a class="mobile-cta__icon" href={`tel:${site.contact.phoneHref}`} tabindex="-1">
    <Icon name="phone" size={22} /><span class="visually-hidden">{tt.cta.call}</span>
  </a>
</div>
<style>
  .mobile-cta {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 30;
    display: flex; gap: 8px; padding: 10px var(--gutter) max(10px, env(safe-area-inset-bottom));
    background: rgb(244 239 230 / 0.96); border-top: 1px solid var(--line);
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    transform: translateY(110%); transition: transform 0.35s var(--ease); visibility: hidden;
  }
  .mobile-cta.is-visible { transform: none; visibility: visible; }
  .mobile-cta__main { flex: 1; min-height: 48px; }
  .mobile-cta__icon { display: inline-grid; place-items: center; width: 48px; height: 48px; border: 1px solid var(--line-strong); flex: none; }
  @media (min-width: 720px) { .mobile-cta { display: none; } }
  @media (prefers-reduced-motion: reduce) { .mobile-cta { transition: none; } }
</style>
