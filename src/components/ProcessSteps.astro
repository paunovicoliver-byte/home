---
import { process } from '../i18n/copy/process';
import type { Locale } from '../i18n/config';
interface Props { locale: Locale; detailed?: boolean }
const { locale, detailed = false } = Astro.props;
const p = process[locale];
---
<ol class:list={['steps', { 'steps--detailed': detailed }]}>
  {p.steps.map((s, i) => (
    <li class="steps__item reveal" id={i === 4 ? 'delivery' : undefined} data-track-view={i === 4 ? 'shipping_info_view' : undefined} data-track-location={i === 4 ? 'process' : undefined}>
      <span class="steps__n" aria-hidden="true">{s.n}</span>
      <div>
        <h3 class="steps__title">{s.title}</h3>
        <p class="steps__text">{s.text}</p>
        {detailed && s.list.length > 0 && <ul class="ticks steps__list">{s.list.map((x) => <li>{x}</li>)}</ul>}
      </div>
    </li>
  ))}
</ol>
<p class="steps__highlight reveal">{p.highlight}</p>
<style>
  .steps { list-style: none; margin: 0; padding: 0; display: grid; border-top: 1px solid var(--line); }
  .steps__item { display: grid; grid-template-columns: 3.2rem 1fr; gap: 12px; align-content: start; padding-block: 22px; border-bottom: 1px solid var(--line); }
  .steps__n { font-family: var(--serif); font-size: 1.6rem; line-height: 1; color: var(--earth); padding-top: 2px; }
  .steps__title { font-size: var(--step-2); line-height: 1.1; margin-bottom: 6px; }
  .steps__text { color: var(--ink-2); max-width: 38em; }
  .steps__list { margin-top: 12px; color: var(--ink-2); columns: 2; column-gap: 24px; font-size: 0.9375rem; }
  .steps__list li { break-inside: avoid; }
  .on-dark .steps, .on-dark .steps__item { border-color: rgb(241 236 226 / 0.2); }
  .on-dark .steps__text, .on-dark .steps__list { color: var(--on-dark); }
  .on-dark .steps__n { color: #c9a173; }
  @media (min-width: 1100px) {
    .steps:not(.steps--detailed) { grid-template-columns: repeat(5, 1fr); border-top: 0; gap: 24px; }
    .steps:not(.steps--detailed) .steps__item { grid-template-columns: 1fr; border-bottom: 0; border-top: 1px solid var(--line); padding-top: 20px; }
    .on-dark .steps:not(.steps--detailed) .steps__item { border-color: rgb(241 236 226 / 0.3); }
    .steps--detailed .steps__item { grid-template-columns: 8rem 1fr; padding-block: 36px; }
    .steps--detailed .steps__n { font-size: 3rem; }
  }
  .steps__highlight { margin-top: 32px; font-family: var(--serif); font-style: italic; font-size: var(--step-2); line-height: 1.2; }
</style>
