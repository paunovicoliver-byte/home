---
import Img from './Img.astro';
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../i18n/config';
import { productPath } from '../lib/pages';
import { t } from '../i18n/ui';
interface Props { entry: CollectionEntry<'products'>; locale: Locale; index?: number; list?: string; sizes?: string }
const { entry, locale, index = 0, list = 'collection', sizes = '(min-width: 1100px) 30vw, (min-width: 640px) 45vw, 92vw' } = Astro.props;
const d = entry.data.i18n[locale]!;
const tt = t(locale);
---
<article class="card reveal">
  <a
    href={productPath(locale, entry)}
    class="card__link"
    data-track="select_item"
    data-track-item-id={entry.id}
    data-track-item-name={entry.id}
    data-track-item-category={entry.data.category}
    data-track-index={index + 1}
    data-track-item-list-id={list}
  >
    <div class="media media--4x5 zoom"><Img src={entry.data.cover.src} alt={entry.data.cover.alt[locale]} ratio={4 / 5} sizes={sizes} /></div>
    <div class="card__body">
      <p class="card__meta">{tt.categories[entry.data.category]}</p>
      <h3 class="card__title">{d.name}</h3>
      <p class="card__text">{d.summary}</p>
    </div>
  </a>
</article>
<style>
  .card__link { display: block; text-decoration: none; }
  .card__body { padding-top: 16px; display: grid; gap: 6px; }
  .card__meta { font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  .card__title { font-size: var(--step-2); line-height: 1.12; }
  .card__link:hover .card__title { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.18em; }
  .card__text { color: var(--ink-2); font-size: 0.9375rem; line-height: 1.55; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
</style>
