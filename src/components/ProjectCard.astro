---
import Img from './Img.astro';
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../i18n/config';
import { projectPath } from '../lib/pages';
interface Props { entry: CollectionEntry<'projects'>; locale: Locale; large?: boolean; sizes?: string }
const { entry, locale, large = false, sizes = '(min-width: 1100px) 45vw, 92vw' } = Astro.props;
const d = entry.data.i18n[locale]!;
---
<article class:list={['pcard reveal', { 'pcard--large': large }]} data-filter-tags={entry.data.filters.join(' ')}>
  <a href={projectPath(locale, entry)} class="pcard__link" data-track="select_project" data-track-project-id={entry.id}>
    <div class:list={['media zoom', large ? 'media--3x2' : 'media--4x3']}><Img src={entry.data.cover.src} alt={entry.data.cover.alt[locale]} ratio={large ? 3 / 2 : 4 / 3} sizes={sizes} /></div>
    <div class="pcard__body">
      <p class="pcard__meta">{d.type}{d.location && ` · ${d.location}`}{entry.data.year && ` · ${entry.data.year}`}</p>
      <h3 class="pcard__title">{d.title}</h3>
      <p class="pcard__text">{d.summary}</p>
    </div>
  </a>
</article>
<style>
  .pcard[hidden] { display: none; }
  .pcard__link { display: block; text-decoration: none; }
  .pcard__body { padding-top: 16px; display: grid; gap: 6px; max-width: 40em; }
  .pcard__meta { font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  .pcard__title { font-size: var(--step-2); line-height: 1.12; }
  .pcard--large .pcard__title { font-size: var(--step-3); }
  .pcard__link:hover .pcard__title { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.18em; }
  .pcard__text { color: var(--ink-2); font-size: 0.9375rem; }
</style>
