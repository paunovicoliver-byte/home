---
interface Props { eyebrow?: string; title: string; lead?: string; level?: 'h1' | 'h2'; size?: 'h1' | 'h2' | 'h3'; class?: string; id?: string }
const { eyebrow, title, lead, level = 'h2', size = 'h2', class: cls = '', id } = Astro.props;
const Tag = level;
---
<div class:list={['head-block', cls]}>
  {eyebrow && <span class="eyebrow">{eyebrow}</span>}
  <Tag class={size} id={id}>{title}</Tag>
  {lead && <p class="lead">{lead}</p>}
  <slot />
</div>
