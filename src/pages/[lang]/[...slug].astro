---
import { getAllPages, type PageEntry } from '../../lib/pages';
import Home from '../../views/Home.astro';
import Windows from '../../views/Windows.astro';
import Heritage from '../../views/Heritage.astro';
import Story from '../../views/Story.astro';
import Process from '../../views/Process.astro';
import Switzerland from '../../views/Switzerland.astro';
import Work from '../../views/Work.astro';
import Product from '../../views/Product.astro';
import Projects from '../../views/Projects.astro';
import Project from '../../views/Project.astro';
import Journal from '../../views/Journal.astro';
import Article from '../../views/Article.astro';
import Start from '../../views/Start.astro';
import Contact from '../../views/Contact.astro';
import Legal from '../../views/Legal.astro';
import System from '../../views/System.astro';

export async function getStaticPaths() {
  const pages = await getAllPages();
  return pages.map((page) => ({
    params: { lang: page.locale, slug: page.path.split('/').filter(Boolean).slice(1).join('/') || undefined },
    props: { page },
  }));
}

const { page } = Astro.props as { page: PageEntry };
---
{page.kind === 'product' && <Product page={page} />}
{page.kind === 'project' && <Project page={page} />}
{page.kind === 'article' && <Article page={page} />}
{page.kind === 'static' && (
  page.key === 'home' ? <Home page={page} /> :
  page.key === 'windows' ? <Windows page={page} /> :
  page.key === 'heritage' ? <Heritage page={page} /> :
  page.key === 'story' ? <Story page={page} /> :
  page.key === 'process' ? <Process page={page} /> :
  page.key === 'switzerland' ? <Switzerland page={page} /> :
  page.key === 'work' ? <Work page={page} /> :
  page.key === 'projects' ? <Projects page={page} /> :
  page.key === 'journal' ? <Journal page={page} /> :
  page.key === 'start' ? <Start page={page} /> :
  page.key === 'contact' ? <Contact page={page} /> :
  page.key === 'privacy' || page.key === 'imprint' ? <Legal page={page} /> :
  <System page={page} />
)}
