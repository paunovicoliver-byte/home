---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { pages } from '../i18n/copy/pages';
import { t } from '../i18n/ui';
import { path } from '../i18n/routes';
import type { PageEntry } from '../lib/pages';
import { webPage } from '../lib/schema';
import { originOf, trail } from '../lib/seo';
import { site } from '../config/site';

interface Props { page: Extract<PageEntry, { kind: 'static' }> }
const { page } = Astro.props;
const { locale } = page;
const c = pages[locale].contact;
const tt = t(locale);
const origin = originOf(Astro.site);
const bc = trail(origin, locale, [{ name: tt.nav.contact, href: page.path }]);
const schema = [webPage(origin, locale, { url: bc.url, name: c.meta.title, description: c.meta.description, type: 'ContactPage', breadcrumbId: bc.id, mainEntity: { '@id': `${origin}/#organization` } }), bc.node];
---
<Base locale={locale} pageType="contact" title={c.meta.title} description={c.meta.description} alternates={page.alternates} schema={schema} currentNav="contact">
  <Breadcrumbs locale={locale} items={bc.items} />
  <header class="container page-intro">
    <span class="eyebrow">{c.eyebrow}</span>
    <h1 class="h1">{c.title}</h1>
    <p class="lead">{c.text}</p>
  </header>
  <section class="section section--tight">
    <div class="container contact__grid">
      <div class="contact__info">
        <div class="aside-block">
          <h2 class="h3">{c.workshopTitle}</h2>
          <p class="muted">{c.workshopText}</p>
          <ul class="direct">
            <li><a href={`tel:${site.contact.phoneHref}`}><Icon name="phone" />{site.contact.phone}</a></li>
            <li><a href={`https://wa.me/${site.contact.whatsapp}`} rel="noopener" target="_blank"><Icon name="whatsapp" />WhatsApp<span class="visually-hidden"> ({tt.a11y.newWindow})</span></a></li>
            <li><a href={`mailto:${site.contact.email}`}><Icon name="mail" />{site.contact.email}</a></li>
          </ul>
        </div>
        <div class="aside-block">
          <h2 class="h3">{c.swissTitle}</h2>
          <p class="muted">{site.contact.switzerland.region}</p>
          <ul class="direct">
            <li><a href={`tel:${site.contact.switzerland.phoneHref}`}><Icon name="phone" />{site.contact.switzerland.phone}</a></li>
          </ul>
          <a class="link-arrow" href={`${path(locale, 'switzerland')}#consultation`} data-track="start_consultation" data-track-location="contact">{tt.cta.bookConsultation}<Icon name="arrow" class="arrow" /></a>
        </div>
        <div class="aside-block">
          <h2 class="h3">{c.projectHint}</h2>
          <a class="btn" href={path(locale, 'start')} data-track="start_project" data-track-location="contact">{tt.cta.startProject}<Icon name="arrow" class="arrow" /></a>
        </div>
      </div>
      <div>
        <h2 class="h2" style="margin-bottom: 1.5rem">{c.formTitle}</h2>
        <EnquiryForm locale={locale} kind="contact" />
      </div>
    </div>
  </section>
</Base>
<style>
  .contact__grid { display: grid; gap: 56px; }
  @media (min-width: 1000px) { .contact__grid { grid-template-columns: 1fr 1.5fr; gap: 80px; } }
  .contact__info { display: grid; gap: 32px; align-content: start; }
  .aside-block { border-top: 1px solid var(--line-strong); padding-top: 20px; display: grid; gap: 12px; justify-items: start; }
  .direct { list-style: none; padding: 0; margin: 0; display: grid; gap: 2px; }
  .direct a { display: inline-flex; gap: 12px; align-items: center; padding-block: 10px; overflow-wrap: anywhere; }
</style>
