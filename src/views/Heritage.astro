---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Img from '../components/Img.astro';
import Icon from '../components/Icon.astro';
import SectionHead from '../components/SectionHead.astro';
import ProjectCard from '../components/ProjectCard.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import CtaBand from '../components/CtaBand.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { heritage } from '../i18n/copy/heritage';
import { t } from '../i18n/ui';
import { path } from '../i18n/routes';
import { getProjects, entryLocales, type PageEntry } from '../lib/pages';
import { webPage, service } from '../lib/schema';
import { originOf, trail } from '../lib/seo';
import heroImg from '../assets/images/heritage-facade.jpg';
import beforeImg from '../assets/images/window-before.jpg';
import afterImg from '../assets/images/window-after.jpg';

interface Props { page: Extract<PageEntry, { kind: 'static' }> }
const { page } = Astro.props;
const { locale } = page;
const c = heritage[locale];
const tt = t(locale);
const origin = originOf(Astro.site);
const bc = trail(origin, locale, [{ name: c.hero.eyebrow, href: page.path }]);
const projects = (await getProjects()).filter((p) => p.data.filters.includes('heritage') && entryLocales(p.data).includes(locale)).slice(0, 4);
const schema = [
  webPage(origin, locale, { url: bc.url, name: c.meta.title, description: c.meta.description, breadcrumbId: bc.id, mainEntity: { '@id': `${bc.url}#service` } }),
  bc.node,
  service(origin, locale, { url: bc.url, name: c.hero.eyebrow, description: c.meta.description, serviceType: c.hero.eyebrow }),
];
---
<Base locale={locale} pageType="heritage" title={c.meta.title} description={c.meta.description} alternates={page.alternates}
  overlayHeader schema={schema} currentNav="heritage" ogImage={heroImg} ogImageAlt={c.hero.imageAlt}>
  <Hero image={heroImg} alt={c.hero.imageAlt} eyebrow={c.hero.eyebrow} title={c.hero.title} lines={[c.hero.text]}>
    <div class="btn-row">
      <a class="btn btn--light" href={`${path(locale, 'start')}?type=restoration`} data-track="start_project" data-track-location="heritage_hero">{tt.cta.heritageCta}<Icon name="arrow" class="arrow" /></a>
    </div>
  </Hero>
  <Breadcrumbs locale={locale} items={bc.items} />

  <section class="section">
    <div class="container grid-2 grid-2--wide-right">
      <h2 class="h2 reveal">{c.intro.title}</h2>
      <div class="prose reveal">{c.intro.text.map((p) => <p class="lead">{p}</p>)}</div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="h-understand">
    <div class="container">
      <SectionHead eyebrow={c.understand.eyebrow} title={c.understand.title} id="h-understand" />
      <ol class="numbered">
        {c.understand.items.map((it, i) => (
          <li class="reveal"><span class="numbered__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><h3>{it.title}</h3><p>{it.text}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="h-decide">
    <div class="container grid-2 grid-2--start">
      <div class="reveal">
        <SectionHead eyebrow={c.decide.eyebrow} title={c.decide.title} id="h-decide" />
        <BeforeAfter locale={locale} id="heritage_page"
          before={{ src: beforeImg, alt: tt.project.before }} after={{ src: afterImg, alt: tt.project.after }} />
      </div>
      <ul class="feature-list feature-list--stack">
        {c.decide.items.map((it) => <li class="reveal"><h3>{it.title}</h3><p>{it.text}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="section on-dark" aria-labelledby="h-exp">
    <div class="container grid-2 grid-2--start">
      <div class="reveal">
        <span class="eyebrow">{c.experience.eyebrow}</span>
        <h2 class="h2" id="h-exp">{c.experience.title}</h2>
        <ul class="list-lines exp-list">{c.experience.items.map((x) => <li>{x}</li>)}</ul>
      </div>
      <aside class="ehh reveal" aria-labelledby="h-ehh">
        <h3 class="h3" id="h-ehh">{c.ehh.title}</h3>
        <p>{c.ehh.text}</p>
        <p class="ehh__note">{c.ehh.note}</p>
      </aside>
    </div>
  </section>

  {projects.length > 0 && (
    <section class="section" aria-labelledby="h-hprojects">
      <div class="container">
        <SectionHead eyebrow={c.projects.eyebrow} title={c.projects.title} id="h-hprojects" />
        <div class="two-col">{projects.map((p) => <ProjectCard entry={p} locale={locale} />)}</div>
      </div>
    </section>
  )}

  <CtaBand locale={locale} title={c.cta.title} text={c.cta.text} cta={tt.cta.heritageCta} projectType="restoration" location="heritage_closing" />
</Base>
<style>
  .numbered { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; border-top: 1px solid var(--line); }
  @media (min-width: 720px) { .numbered { grid-template-columns: 1fr 1fr; column-gap: 32px; } }
  @media (min-width: 1100px) { .numbered { grid-template-columns: repeat(3, 1fr); } }
  .numbered li { padding-block: 24px; border-bottom: 1px solid var(--line); display: grid; gap: 6px; }
  .numbered__n { font-family: var(--serif); color: var(--earth); font-size: 1.4rem; }
  .numbered h3 { font-size: var(--step-2); }
  .numbered p { color: var(--ink-2); }
  .feature-list--stack > li { grid-template-columns: 1fr !important; }
  .exp-list { margin-top: 2rem; font-size: var(--step-1); }
  .ehh { border: 1px solid rgb(241 236 226 / 0.3); padding: clamp(24px, 4vw, 40px); display: grid; gap: 14px; }
  .ehh__note { font-size: 0.875rem; color: var(--on-dark-muted); }
</style>
