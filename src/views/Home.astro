---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Img from '../components/Img.astro';
import Icon from '../components/Icon.astro';
import SectionHead from '../components/SectionHead.astro';
import CategoryGrid from '../components/CategoryGrid.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { home } from '../i18n/copy/home';
import { t } from '../i18n/ui';
import { path } from '../i18n/routes';
import { getProjects, getArticles, entryLocales, type PageEntry } from '../lib/pages';
import { webPage } from '../lib/schema';
import { originOf } from '../lib/seo';
import heroImg from '../assets/images/hero-workshop.jpg';
import windowsImg from '../assets/images/window-traditional.jpg';
import windowsDetail from '../assets/images/grain-oak.jpg';
import heritageImg from '../assets/images/heritage-facade.jpg';
import forestImg from '../assets/images/forest-portrait.jpg';
import endGrain from '../assets/images/end-grain.jpg';
import swissImg from '../assets/images/switzerland.jpg';

interface Props { page: Extract<PageEntry, { kind: 'static' }> }
const { page } = Astro.props;
const { locale } = page;
const c = home[locale];
const tt = t(locale);
const origin = originOf(Astro.site);
const url = new URL(page.path, origin).href;
const projects = (await getProjects()).filter((p) => p.data.featured && entryLocales(p.data).includes(locale)).slice(0, 3);
const articles = (await getArticles()).filter((a) => entryLocales(a.data).includes(locale)).slice(0, 3);
const schema = [webPage(origin, locale, { url, name: c.meta.title, description: c.meta.description })];
---
<Base locale={locale} pageType="home" title={c.meta.title} description={c.meta.description} alternates={page.alternates}
  overlayHeader schema={schema} currentNav="home" ogImage={heroImg} ogImageAlt={c.hero.imageAlt}>
  <Hero image={heroImg} alt={c.hero.imageAlt} title={c.hero.title} lines={c.hero.lines} size="full" brand video>
    <div class="btn-row">
      <a class="btn btn--light" href={path(locale, 'start')} data-track="start_project" data-track-location="hero">{tt.cta.startProject}<Icon name="arrow" class="arrow" /></a>
      <a class="btn btn--ghost-light" href={path(locale, 'work')} data-track="discover_work" data-track-location="hero">{tt.cta.discoverWork}</a>
    </div>
    <p class="regions">{tt.brand.regions}</p>
  </Hero>

  <section class="facts" aria-label={c.intro.eyebrow}>
    <ul class="container facts__list">
      {c.facts.map((f) => <li>{f}</li>)}
    </ul>
  </section>

  <section class="section">
    <div class="container grid-2 grid-2--wide-right">
      <div class="reveal">
        <span class="eyebrow">{c.intro.eyebrow}</span>
        <h2 class="h2">{c.intro.title}</h2>
      </div>
      <div class="prose reveal">
        {c.intro.text.map((p) => <p class="lead">{p}</p>)}
        <p><a class="link-arrow" href={path(locale, 'story')}>{tt.cta.readStory}<Icon name="arrow" class="arrow" /></a></p>
      </div>
    </div>
  </section>

  <section class="section section--alt windows-feature" aria-labelledby="h-windows">
    <div class="container grid-2 grid-2--wide-left">
      <div class="windows-feature__media reveal">
        <div class="media media--4x5"><Img src={windowsImg} alt={tt.categories.windows} ratio={4 / 5} sizes="(min-width: 900px) 40vw, 92vw" /></div>
        <div class="media media--1x1 windows-feature__detail"><Img src={windowsDetail} alt="" ratio={1} sizes="(min-width: 900px) 18vw, 40vw" /></div>
      </div>
      <div class="reveal">
        <span class="eyebrow">{c.windows.eyebrow}</span>
        <h2 class="h1" id="h-windows">{c.windows.title}</h2>
        <div class="prose" style="margin-top: 1.5rem">{c.windows.text.map((p) => <p>{p}</p>)}</div>
        <div class="btn-row" style="margin-top: 2rem">
          <a class="btn" href={`${path(locale, 'start')}?type=windows`} data-track="start_project" data-track-location="home_windows">{tt.cta.discussWindows}<Icon name="arrow" class="arrow" /></a>
          <a class="btn btn--ghost" href={path(locale, 'windows')}>{c.windows.more}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="h-cats">
    <div class="container">
      <SectionHead eyebrow={c.categories.eyebrow} title={c.categories.title} lead={c.categories.text} id="h-cats" />
      <CategoryGrid locale={locale} />
    </div>
  </section>

  <section class="heritage-band" aria-labelledby="h-heritage">
    <div class="heritage-band__media"><Img src={heritageImg} alt="" sizes="100vw" /></div>
    <div class="container heritage-band__inner">
      <div class="heritage-band__card reveal">
        <span class="eyebrow">{c.heritage.eyebrow}</span>
        <h2 class="h2" id="h-heritage">{c.heritage.title}</h2>
        <p>{c.heritage.text}</p>
        <a class="link-arrow" href={path(locale, 'heritage')}>{c.heritage.more}<Icon name="arrow" class="arrow" /></a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="h-philosophy">
    <div class="container">
      <div class="grid-2 grid-2--start">
        <div class="reveal">
          <span class="eyebrow">{c.philosophy.eyebrow}</span>
          <h2 class="display" id="h-philosophy">{c.philosophy.title}</h2>
        </div>
        <div class="reveal">
          <p class="lead">{c.philosophy.lead}</p>
          <ul class="principles">
            {c.philosophy.points.map((p) => (
              <li><h3 class="h3">{p.title}</h3><p>{p.text}</p></li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section on-dark forest" aria-labelledby="h-forest">
    <div class="container grid-2">
      <div class="media media--4x5 reveal"><Img src={forestImg} alt={c.forest.imageAlt} ratio={4 / 5} sizes="(min-width: 900px) 45vw, 92vw" /></div>
      <div class="reveal">
        <span class="eyebrow">{c.forest.eyebrow}</span>
        <h2 class="h1" id="h-forest">{c.forest.title}</h2>
        <div class="prose" style="margin-top: 1.5rem">{c.forest.text.map((p) => <p class="lead">{p}</p>)}</div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="h-process">
    <div class="container">
      <SectionHead eyebrow={c.process.eyebrow} title={c.process.title} id="h-process" />
      <ProcessSteps locale={locale} />
      <p style="margin-top: 2rem"><a class="link-arrow" href={path(locale, 'process')}>{c.process.more}<Icon name="arrow" class="arrow" /></a></p>
    </div>
  </section>

  {projects.length > 0 && (
    <section class="section section--alt" aria-labelledby="h-projects">
      <div class="container">
        <div class="row-head">
          <SectionHead eyebrow={c.projects.eyebrow} title={c.projects.title} id="h-projects" />
          <a class="link-arrow" href={path(locale, 'projects')}>{tt.cta.allProjects}<Icon name="arrow" class="arrow" /></a>
        </div>
        <div class="projects-grid">
          {projects.map((p, i) => <ProjectCard entry={p} locale={locale} large={i === 0} />)}
        </div>
      </div>
    </section>
  )}

  <section class="section" aria-labelledby="h-swiss">
    <div class="container grid-2 grid-2--wide-right">
      <div class="media media--4x3 reveal"><Img src={swissImg} alt="" ratio={4 / 3} sizes="(min-width: 900px) 45vw, 92vw" /></div>
      <div class="reveal">
        <span class="eyebrow">{c.switzerland.eyebrow}</span>
        <h2 class="h2" id="h-swiss">{c.switzerland.title}</h2>
        <p class="lead" style="margin-top: 1.25rem">{c.switzerland.text}</p>
        <div class="btn-row" style="margin-top: 2rem">
          <a class="btn" href={`${path(locale, 'switzerland')}#consultation`} data-track="start_consultation" data-track-location="home_switzerland">{tt.cta.bookConsultation}</a>
          <a class="btn btn--ghost" href={path(locale, 'switzerland')}>{c.switzerland.more}</a>
        </div>
      </div>
    </div>
  </section>

  {articles.length > 0 && (
    <section class="section section--alt" aria-labelledby="h-journal">
      <div class="container">
        <div class="row-head">
          <SectionHead eyebrow={c.journal.eyebrow} title={c.journal.title} id="h-journal" />
          <a class="link-arrow" href={path(locale, 'journal')}>{tt.cta.allArticles}<Icon name="arrow" class="arrow" /></a>
        </div>
        <div class="cards-3">{articles.map((a) => <ArticleCard entry={a} locale={locale} />)}</div>
      </div>
    </section>
  )}

  <CtaBand locale={locale} />
</Base>

<style>
  .facts { border-bottom: 1px solid var(--line); background: var(--paper); }
  .facts__list { list-style: none; margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0; padding-block: 8px; }
  .facts__list li { padding: 14px 0; font-size: 0.875rem; font-weight: 500; border-bottom: 1px solid var(--line); padding-right: 12px; }
  .facts__list li:nth-last-child(-n + 2) { border-bottom: 0; }
  @media (min-width: 900px) {
    .facts__list { grid-template-columns: repeat(6, 1fr); padding-block: 0; }
    .facts__list li { border-bottom: 0; border-left: 1px solid var(--line); padding: 22px 16px; }
    .facts__list li:first-child { border-left: 0; padding-left: 0; }
  }
  .windows-feature__media { position: relative; padding-bottom: 12%; }
  .windows-feature__detail { position: absolute; width: 42%; right: -4%; bottom: 0; border: 8px solid var(--paper-2); }
  @media (min-width: 900px) { .windows-feature__detail { right: -12%; } }
  .heritage-band { position: relative; isolation: isolate; padding-block: clamp(120px, 22vw, 280px) var(--space-section); }
  .heritage-band__media { position: absolute; inset: 0; z-index: -1; }
  .heritage-band__media :global(picture), .heritage-band__media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .heritage-band__card { background: var(--paper); padding: clamp(24px, 5vw, 56px); max-width: 620px; display: grid; gap: 16px; }
  .heritage-band__card .link-arrow { justify-self: start; }
  .principles { list-style: none; padding: 0; margin: 2rem 0 0; border-top: 1px solid var(--line); }
  .principles li { padding-block: 22px; border-bottom: 1px solid var(--line); display: grid; gap: 6px; }
  .principles p { color: var(--ink-2); }
  .forest { background: var(--forest-2); }
  .row-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 0 24px; margin-bottom: var(--space-block); }
  .row-head :global(.head-block) { margin-bottom: 0; }
  .row-head > .link-arrow { margin-bottom: 8px; }
  .projects-grid { display: grid; gap: 48px 24px; }
  @media (min-width: 900px) {
    .projects-grid { grid-template-columns: 1fr 1fr; }
    .projects-grid > :global(:first-child) { grid-column: 1 / -1; }
  }
</style>
