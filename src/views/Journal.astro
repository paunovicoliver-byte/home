---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import CtaBand from '../components/CtaBand.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { pages } from '../i18n/copy/pages';
import { t } from '../i18n/ui';
import { getArticles, entryLocales, articlePath, type PageEntry } from '../lib/pages';
import { webPage } from '../lib/schema';
import { originOf, trail } from '../lib/seo';

interface Props { page: Extract<PageEntry, { kind: 'static' }> }
const { page } = Astro.props;
const { locale } = page;
const c = pages[locale].journal;
const tt = t(locale);
const origin = originOf(Astro.site);
const bc = trail(origin, locale, [{ name: tt.nav.journal, href: page.path }]);
const articles = (await getArticles()).filter((a) => entryLocales(a.data).includes(locale));
const blog = {
  '@type': 'Blog', '@id': `${bc.url}#blog`, name: tt.journal.title, inLanguage: { en: 'en', de: 'de-CH', sr: 'sr-RS' }[locale],
  blogPost: articles.map((a) => ({ '@type': 'BlogPosting', headline: a.data.i18n[locale]!.title, url: new URL(articlePath(locale, a), origin).href, datePublished: a.data.date.toISOString().slice(0, 10) })),
};
const schema = [webPage(origin, locale, { url: bc.url, name: c.meta.title, description: c.meta.description, type: 'CollectionPage', breadcrumbId: bc.id, mainEntity: { '@id': `${bc.url}#blog` } }), bc.node, blog];
---
<Base locale={locale} pageType="journal" title={c.meta.title} description={c.meta.description} alternates={page.alternates} schema={schema} currentNav="journal">
  <Breadcrumbs locale={locale} items={bc.items} />
  <header class="container page-intro">
    <span class="eyebrow">{c.eyebrow}</span>
    <h1 class="h1">{c.title}</h1>
    <p class="lead">{c.text}</p>
  </header>
  <section class="section section--tight" aria-label={c.title}>
    <div class="container cards-3">{articles.map((a) => <ArticleCard entry={a} locale={locale} />)}</div>
  </section>
  <CtaBand locale={locale} location="journal_closing" />
</Base>
