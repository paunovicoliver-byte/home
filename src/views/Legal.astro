---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { marked } from 'marked';
import { pages } from '../i18n/copy/pages';
import { legal } from '../i18n/copy/legal';
import { t } from '../i18n/ui';
import type { PageEntry } from '../lib/pages';
import { webPage } from '../lib/schema';
import { originOf, trail } from '../lib/seo';

interface Props { page: Extract<PageEntry, { kind: 'static' }> }
const { page } = Astro.props;
const { locale } = page;
const key = page.key as 'privacy' | 'imprint';
const c = pages[locale][key];
const tt = t(locale);
const origin = originOf(Astro.site);
const bc = trail(origin, locale, [{ name: c.title, href: page.path }]);
const html = await marked.parse(legal[key][locale], { gfm: true, breaks: key === 'imprint' });
const schema = [webPage(origin, locale, { url: bc.url, name: c.meta.title, description: c.meta.description, breadcrumbId: bc.id }), bc.node];
---
<Base locale={locale} pageType={key} title={c.meta.title} description={c.meta.description} alternates={page.alternates} schema={schema}>
  <Breadcrumbs locale={locale} items={bc.items} />
  <header class="container page-intro"><h1 class="h1">{c.title}</h1></header>
  <section class="section section--tight">
    <div class="container"><div class="prose" set:html={html} /></div>
    {key === 'privacy' && (
      <div class="container" style="margin-top: 2rem">
        <button type="button" class="btn btn--ghost" data-consent-open>{tt.footer.cookieSettings}</button>
      </div>
    )}
  </section>
</Base>
