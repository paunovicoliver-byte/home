---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import Icon from '../components/Icon.astro';
import Gallery from '../components/Gallery.astro';
import ProductCard from '../components/ProductCard.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { t } from '../i18n/ui';
import { path } from '../i18n/routes';
import { getProducts, entryLocales, type PageEntry } from '../lib/pages';
import { webPage, product as productNode } from '../lib/schema';
import { originOf, trail } from '../lib/seo';
import { getImage } from 'astro:assets';

interface Props { page: Extract<PageEntry, { kind: 'product' }> }
const { page } = Astro.props;
const { locale, entry } = page;
const data = entry.data;
const d = data.i18n[locale]!;
const tt = t(locale);
const p = tt.product;
const origin = originOf(Astro.site);
const bc = trail(origin, locale, [{ name: tt.nav.work, href: path(locale, 'work') }, { name: d.name, href: page.path }]);
const title = `${d.seoTitle ?? d.name} | DRVENO`;
const images = [data.cover, ...data.gallery].map((g) => ({ src: g.src, alt: g.alt[locale] }));
const schemaImages = await Promise.all(images.slice(0, 3).map(async (im) => new URL((await getImage({ src: im.src, width: 1200, format: 'jpg' })).src, origin).href));
const schema = [
  webPage(origin, locale, { url: bc.url, name: title, description: d.seoDescription, type: 'ItemPage', breadcrumbId: bc.id, mainEntity: { '@id': `${bc.url}#product` }, image: schemaImages[0] }),
  bc.node,
  productNode(origin, { url: bc.url, name: d.name, description: d.summary, images: schemaImages, category: tt.categories[data.category], material: d.wood }),
];
const related = (await getProducts()).filter((x) => x.id !== entry.id && entryLocales(x.data).includes(locale))
  .sort((a, b) => Number(b.data.category === data.category) - Number(a.data.category === data.category)).slice(0, 3);
const startHref = `${path(locale, 'start')}?type=${data.projectType}&piece=${entry.id}`;
const item = { item_id: entry.id, item_name: entry.id, item_category: data.category };
const pageEvents = [{ event: 'view_item', params: { items: [item] } }];
---
<Base locale={locale} pageType="product" title={title} description={d.seoDescription} alternates={page.alternates} schema={schema}
  currentNav="work" ogImage={data.cover.src} ogImageAlt={data.cover.alt[locale]} ogType="product" pageEvents={pageEvents}>
  <Breadcrumbs locale={locale} items={bc.items} />
  <article>
    <div class="container product">
      <div class="product__media">
        <div class="media media--4x5 product__cover">
          <Img src={data.cover.src} alt={data.cover.alt[locale]} ratio={4 / 5} priority sizes="(min-width: 960px) 55vw, 100vw" />
        </div>
      </div>
      <div class="product__info">
        <p class="eyebrow">{tt.categories[data.category]}</p>
        <h1 class="h1">{d.name}</h1>
        <p class="lead">{d.summary}</p>
        <ul class="badges">
          <li>{p.handmade}</li>
          <li>{p.madeToOrder}</li>
          {data.customizable && <li>{p.customizable}</li>}
        </ul>
        <dl class="specs-short">
          <div><dt>{p.wood}</dt><dd>{d.wood}</dd></div>
          <div><dt>{p.dimensions}</dt><dd>{d.dimensions}</dd></div>
          <div><dt>{p.finish}</dt><dd>{d.finish}</dd></div>
          <div><dt>{p.production}</dt><dd>{p.productionValue}</dd></div>
        </dl>
        <div class="product__ctas">
          <a class="btn btn--block" href={startHref} data-track="start_project" data-track-location="product_quote" data-track-item-id={entry.id}>{tt.cta.requestQuote}<Icon name="arrow" class="arrow" /></a>
          <a class="btn btn--ghost btn--block" href={`${startHref}&customize=1`} data-track="customize_piece" data-track-item-id={entry.id}>{tt.cta.customize}</a>
        </div>
        <p class="product__pricing">{p.pricing}</p>
      </div>
    </div>

    <section class="section" aria-labelledby="h-story">
      <div class="container grid-2 grid-2--start">
        <h2 class="h2" id="h-story">{p.story}</h2>
        <div class="prose">
          {d.story.map((s) => <p class="lead">{s}</p>)}
          <p class="unique">{p.unique}</p>
        </div>
      </div>
    </section>

    {images.length > 1 && (
      <section class="section section--tight" aria-labelledby="h-gallery">
        <div class="container">
          <h2 class="h3" id="h-gallery" style="margin-bottom: 1.5rem">{p.gallery}</h2>
          <Gallery locale={locale} id={`product_${entry.id}`} images={images.slice(1)} label={`${p.gallery}: ${d.name}`} />
        </div>
      </section>
    )}

    <section class="section section--alt" aria-labelledby="h-specs">
      <div class="container grid-2 grid-2--start">
        <div>
          <h2 class="h2" id="h-specs">{p.specifications}</h2>
          <dl class="spec-table">
            <div><dt>{p.wood}</dt><dd>{d.wood}</dd></div>
            <div><dt>{p.dimensions}</dt><dd>{d.dimensions}</dd></div>
            <div><dt>{p.finish}</dt><dd>{d.finish}</dd></div>
            {d.specs.map((s) => <div><dt>{s.label}</dt><dd>{s.value}</dd></div>)}
          </dl>
        </div>
        <div class="stack">
          <details class="disclosure" open>
            <summary><h3>{p.care}</h3></summary>
            <ul class="ticks">{d.care.map((c) => <li>{c}</li>)}</ul>
          </details>
          <details class="disclosure" data-track-view="shipping_info_view" data-track-location="product">
            <summary data-track="shipping_info_view" data-track-trigger="open" data-track-item-id={entry.id}><h3>{p.production} &amp; {p.shipping}</h3></summary>
            <p><strong>{p.production}:</strong> {p.productionValue}</p>
            <p><strong>{p.shipping}:</strong> {p.shippingValue}</p>
          </details>
        </div>
      </div>
    </section>

    <section class="section" aria-label={tt.nav.process}>
      <div class="container"><ProcessSteps locale={locale} /></div>
    </section>

    <section class="section section--alt" aria-labelledby="h-related">
      <div class="container">
        <h2 class="h2" id="h-related" style="margin-bottom: 2rem">{p.related}</h2>
        <div class="cards-3">{related.map((r, i) => <ProductCard entry={r} locale={locale} index={i} list="related" />)}</div>
      </div>
    </section>
  </article>

</Base>
<style>
  .product { display: grid; gap: 28px; padding-top: 16px; }
  @media (min-width: 960px) {
    .product { grid-template-columns: 1.15fr 1fr; gap: 64px; align-items: start; padding-top: 24px; }
    .product__info { position: sticky; top: calc(var(--header-h) + 24px); }
  }
  .product__info { display: grid; gap: 18px; align-content: start; }
  .product__info .eyebrow { margin-bottom: 0; }
  .badges { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .badges li { font-size: 0.8125rem; padding: 6px 12px; border: 1px solid var(--line-strong); }
  .specs-short { margin: 0; border-top: 1px solid var(--line); }
  .specs-short > div { display: grid; grid-template-columns: 7.5rem 1fr; gap: 12px; padding-block: 12px; border-bottom: 1px solid var(--line); font-size: 0.9375rem; }
  .specs-short dt { color: var(--muted); }
  .specs-short dd { margin: 0; }
  .product__ctas { display: grid; gap: 10px; margin-top: 6px; }
  .product__pricing { font-size: 0.875rem; color: var(--muted); }
  .unique { font-family: var(--serif); font-style: italic; font-size: var(--step-2); line-height: 1.25; color: var(--ink); }
  .spec-table { margin: 2rem 0 0; border-top: 1px solid var(--line-strong); }
  .spec-table > div { display: grid; grid-template-columns: minmax(8rem, 0.6fr) 1fr; gap: 16px; padding-block: 14px; border-bottom: 1px solid var(--line); }
  .spec-table dt { color: var(--muted); font-size: 0.9375rem; }
  .spec-table dd { margin: 0; }
  .disclosure { border-top: 1px solid var(--line-strong); padding-block: 8px 20px; }
  .disclosure summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; min-height: 48px; }
  .disclosure summary::-webkit-details-marker { display: none; }
  .disclosure summary::after { content: '+'; font-size: 1.5rem; font-weight: 300; }
  .disclosure[open] summary::after { content: '−'; }
  .disclosure h3 { font-size: var(--step-2); }
  .disclosure > :not(summary) { margin-top: 10px; color: var(--ink-2); }
</style>
