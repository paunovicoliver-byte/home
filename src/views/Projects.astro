---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CtaBand from '../components/CtaBand.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { pages } from '../i18n/copy/pages';
import { t, fmt } from '../i18n/ui';
import { getProjects, entryLocales, projectPath, type PageEntry } from '../lib/pages';
import { webPage } from '../lib/schema';
import { originOf, trail } from '../lib/seo';

interface Props { page: Extract<PageEntry, { kind: 'static' }> }
const { page } = Astro.props;
const { locale } = page;
const c = pages[locale].projects;
const tt = t(locale);
const f = tt.filters;
const origin = originOf(Astro.site);
const bc = trail(origin, locale, [{ name: tt.nav.projects, href: page.path }]);
const projects = (await getProjects()).filter((p) => entryLocales(p.data).includes(locale));
const filters = ['windows', 'heritage', 'houses', 'public', 'tables', 'doors', 'custom'] as const;
const itemList = {
  '@type': 'ItemList', '@id': `${bc.url}#list`,
  itemListElement: projects.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: new URL(projectPath(locale, p), origin).href, name: p.data.i18n[locale]!.title })),
};
const schema = [webPage(origin, locale, { url: bc.url, name: c.meta.title, description: c.meta.description, type: 'CollectionPage', breadcrumbId: bc.id, mainEntity: { '@id': `${bc.url}#list` } }), bc.node, itemList];
---
<Base locale={locale} pageType="projects" title={c.meta.title} description={c.meta.description} alternates={page.alternates} schema={schema} currentNav="projects">
  <Breadcrumbs locale={locale} items={bc.items} />
  <header class="container page-intro">
    <span class="eyebrow">{c.eyebrow}</span>
    <h1 class="h1">{c.title}</h1>
    <p class="lead">{c.text}</p>
  </header>

  <section class="section section--tight" aria-label={c.eyebrow}>
    <div class="container">
      <div class="filters" data-filters hidden role="group" aria-label={f.label}>
        <button type="button" data-filter="all" aria-pressed="true">{f.all}</button>
        {filters.map((k) => <button type="button" data-filter={k} aria-pressed="false">{f[k]}</button>)}
      </div>
      <p class="filter-count" data-filter-count data-one={f.countOne} data-many={f.count} aria-live="polite">{fmt(f.count, { count: projects.length })}</p>
      <div class="two-col">{projects.map((p) => <ProjectCard entry={p} locale={locale} />)}</div>
      <p class="filter-empty" data-filter-empty hidden>{f.empty}</p>
    </div>
  </section>
  <CtaBand locale={locale} location="projects_closing" />
</Base>
<style>
  .filters { display: flex; gap: 8px; overflow-x: auto; padding-bottom: 6px; margin-bottom: 12px; scrollbar-width: thin; -webkit-overflow-scrolling: touch; }
  .filters[hidden] { display: none; }
  .filters button {
    flex: none; min-height: 44px; padding: 0 16px; border: 1px solid var(--line-strong); background: transparent;
    font-size: 0.875rem; cursor: pointer; white-space: nowrap;
  }
  .filters button:hover { border-color: var(--ink); }
  .filters button[aria-pressed='true'] { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .filter-count { font-size: 0.875rem; color: var(--muted); margin-bottom: 28px; }
  .filter-empty { padding: 32px; border: 1px dashed var(--line-strong); }
</style>
