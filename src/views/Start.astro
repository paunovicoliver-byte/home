---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { pages } from '../i18n/copy/pages';
import { process } from '../i18n/copy/process';
import { t } from '../i18n/ui';
import { getProducts, entryLocales, type PageEntry } from '../lib/pages';
import { webPage } from '../lib/schema';
import { originOf, trail } from '../lib/seo';
import { site } from '../config/site';

interface Props { page: Extract<PageEntry, { kind: 'static' }> }
const { page } = Astro.props;
const { locale } = page;
const c = pages[locale].start;
const tt = t(locale);
const origin = originOf(Astro.site);
const bc = trail(origin, locale, [{ name: tt.nav.start, href: page.path }]);
const pieces = Object.fromEntries((await getProducts()).filter((p) => entryLocales(p.data).includes(locale)).map((p) => [p.id, p.data.i18n[locale]!.name]));
const schema = [webPage(origin, locale, { url: bc.url, name: c.meta.title, description: c.meta.description, type: 'ContactPage', breadcrumbId: bc.id }), bc.node];
const ideas = process[locale].steps[0];
---
<Base locale={locale} pageType="start" title={c.meta.title} description={c.meta.description} alternates={page.alternates} schema={schema} currentNav="start" hideMobileCta>
  <Breadcrumbs locale={locale} items={bc.items} />
  <header class="container page-intro">
    <span class="eyebrow">{c.eyebrow}</span>
    <h1 class="h1" style="max-width: 16ch">{c.title}</h1>
    <p class="lead">{c.text}</p>
  </header>
  <section class="section section--tight start" aria-label={c.title}>
    <div class="container start__grid">
      <div class="start__form"><EnquiryForm locale={locale} kind="quote" pieces={pieces} /></div>
      <aside class="start__aside">
        <div class="aside-block">
          <h2 class="h3">{ideas.title}</h2>
          <p class="muted">{ideas.text}</p>
          <ul class="ticks">{ideas.list.map((x) => <li>{x}</li>)}</ul>
        </div>
        <div class="aside-block">
          <h2 class="h3">{c.asideTitle}</h2>
          <ol class="next-steps">{c.aside.map((x) => <li>{x}</li>)}</ol>
        </div>
        <div class="aside-block">
          <h2 class="h3">{c.directTitle}</h2>
          <ul class="direct">
            <li><a href={`tel:${site.contact.phoneHref}`}><Icon name="phone" />{site.contact.phone}</a></li>
            <li><a href={`tel:${site.contact.switzerland.phoneHref}`}><Icon name="phone" />{site.contact.switzerland.phone}</a></li>
            <li><a href={`https://wa.me/${site.contact.whatsapp}`} rel="noopener" target="_blank"><Icon name="whatsapp" />WhatsApp<span class="visually-hidden"> ({tt.a11y.newWindow})</span></a></li>
            <li><a href={`mailto:${site.contact.email}`}><Icon name="mail" />{site.contact.email}</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </section>
</Base>
<style>
  .start__grid { display: grid; gap: 56px; }
  @media (min-width: 1000px) { .start__grid { grid-template-columns: 1.6fr 1fr; gap: 80px; align-items: start; } .start__aside { position: sticky; top: calc(var(--header-h) + 24px); } }
  .start__aside { display: grid; gap: 32px; }
  .aside-block { border-top: 1px solid var(--line-strong); padding-top: 20px; display: grid; gap: 12px; }
  .next-steps { padding-left: 1.2em; margin: 0; display: grid; gap: 6px; color: var(--ink-2); }
  .direct { list-style: none; padding: 0; margin: 0; display: grid; gap: 2px; }
  .direct a { display: inline-flex; gap: 12px; align-items: center; padding-block: 10px; overflow-wrap: anywhere; }
</style>
