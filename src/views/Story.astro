---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Img from '../components/Img.astro';
import CtaBand from '../components/CtaBand.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { story } from '../i18n/copy/story';
import { t } from '../i18n/ui';
import type { PageEntry } from '../lib/pages';
import { webPage } from '../lib/schema';
import { originOf, trail } from '../lib/seo';
import heroImg from '../assets/images/end-grain.jpg';
import forestImg from '../assets/images/forest.jpg';
import benchImg from '../assets/images/workbench.jpg';
import swissImg from '../assets/images/switzerland.jpg';
import grainImg from '../assets/images/grain-walnut.jpg';
import windowImg from '../assets/images/window-traditional.jpg';

interface Props { page: Extract<PageEntry, { kind: 'static' }> }
const { page } = Astro.props;
const { locale } = page;
const c = story[locale];
const tt = t(locale);
const origin = originOf(Astro.site);
const bc = trail(origin, locale, [{ name: tt.nav.story, href: page.path }]);
const chapterImages = [benchImg, swissImg, windowImg, grainImg];
const schema = [
  webPage(origin, locale, { url: bc.url, name: c.meta.title, description: c.meta.description, type: 'AboutPage', breadcrumbId: bc.id, mainEntity: { '@id': `${origin}/#organization` } }),
  bc.node,
];
---
<Base locale={locale} pageType="story" title={c.meta.title} description={c.meta.description} alternates={page.alternates}
  overlayHeader schema={schema} currentNav="story" ogImage={heroImg} ogImageAlt={c.hero.imageAlt}>
  <Hero image={heroImg} alt={c.hero.imageAlt} eyebrow={c.hero.eyebrow} title={c.hero.title} lines={[c.hero.text]} />
  <Breadcrumbs locale={locale} items={bc.items} />

  <div class="chapters">
    {c.chapters.map((ch, i) => (
      <section class="section chapter" aria-labelledby={`ch-${i}`}>
        <div class:list={['container grid-2', i % 2 ? 'grid-2--wide-left' : 'grid-2--wide-right']}>
          <div class:list={['media media--4x5 reveal', { 'order-md-first': i % 2 === 0 }]}>
            <Img src={chapterImages[i]} alt="" ratio={4 / 5} sizes="(min-width: 900px) 40vw, 92vw" />
          </div>
          <div class="reveal chapter__text">
            <span class="eyebrow"><span class="chapter__n">{String(i + 1).padStart(2, '0')}</span> {ch.label}</span>
            <h2 class="h2" id={`ch-${i}`}>{ch.title}</h2>
            <div class="prose">{ch.text.map((p) => <p class="lead">{p}</p>)}</div>
          </div>
        </div>
      </section>
    ))}
  </div>

  <section class="quote on-dark" aria-label={c.quote.text}>
    <div class="container narrow reveal">
      <blockquote><p>{c.quote.text}</p></blockquote>
    </div>
  </section>

  <section class="section" aria-labelledby="h-forest">
    <div class="container grid-2">
      <div class="reveal">
        <span class="eyebrow">{c.forest.eyebrow}</span>
        <h2 class="h1" id="h-forest">{c.forest.title}</h2>
        <div class="prose" style="margin-top:1.5rem">{c.forest.text.map((p) => <p class="lead">{p}</p>)}</div>
      </div>
      <div class="media media--4x3 reveal"><Img src={forestImg} alt={c.forest.imageAlt} ratio={4 / 3} sizes="(min-width: 900px) 45vw, 92vw" /></div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="h-today">
    <div class="container grid-2 grid-2--wide-right">
      <div class="reveal"><span class="eyebrow">{c.today.eyebrow}</span><h2 class="h2" id="h-today">{c.today.title}</h2></div>
      <div class="prose reveal">{c.today.text.map((p) => <p class="lead">{p}</p>)}</div>
    </div>
  </section>

  <CtaBand locale={locale} location="story_closing" />
</Base>
<style>
  .chapter + .chapter { padding-top: 0; }
  .chapter__n { color: var(--earth); margin-right: 0.6em; }
  .chapter__text .prose { margin-top: 1.5rem; }
  .quote { padding-block: var(--space-section); background: var(--walnut); }
  .quote blockquote { margin: 0; font-family: var(--serif); font-style: italic; font-size: var(--step-4); line-height: 1.1; text-align: center; text-wrap: balance; }
</style>
