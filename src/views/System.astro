---
/** Thank-you page (no-JS form fallback) and localized 404. Both noindex. */
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { pages } from '../i18n/copy/pages';
import { t } from '../i18n/ui';
import { path } from '../i18n/routes';
import type { PageEntry } from '../lib/pages';

interface Props { page: Extract<PageEntry, { kind: 'static' }> }
const { page } = Astro.props;
const { locale } = page;
const tt = t(locale);
const is404 = page.key === 'notFound';
const meta = is404 ? pages[locale].notFound.meta : pages[locale].thanks.meta;
const copy = is404 ? tt.notFound : tt.thanks;
---
<Base locale={locale} pageType={page.pageType} title={meta.title} description={meta.description} alternates={page.alternates} noindex hideMobileCta>
  <section class="section">
    <div class="container narrow">
      {!is404 && <Icon name="check" size={40} />}
      <h1 class="h1" style="margin-top: 1rem">{copy.title}</h1>
      <p class="lead" style="margin-top: 1.25rem">{copy.text}</p>
      <div class="btn-row" style="margin-top: 2rem">
        <a class="btn" href={path(locale, 'home')}>{tt.cta.backHome}</a>
        {is404 && <a class="btn btn--ghost" href={path(locale, 'start')} data-track="start_project" data-track-location="404">{tt.cta.startProject}</a>}
        {!is404 && <a class="btn btn--ghost" href={path(locale, 'projects')}>{tt.nav.projects}</a>}
      </div>
    </div>
  </section>
</Base>
