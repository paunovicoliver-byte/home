---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Img from '../components/Img.astro';
import Icon from '../components/Icon.astro';
import SectionHead from '../components/SectionHead.astro';
import ProductCard from '../components/ProductCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CtaBand from '../components/CtaBand.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { windows } from '../i18n/copy/windows';
import { t } from '../i18n/ui';
import { path } from '../i18n/routes';
import { getProducts, getProjects, entryLocales, type PageEntry } from '../lib/pages';
import { webPage, service } from '../lib/schema';
import { originOf, trail } from '../lib/seo';
import heroImg from '../assets/images/windows-hero.jpg';
import detailImg from '../assets/images/window-arched.jpg';

interface Props { page: Extract<PageEntry, { kind: 'static' }> }
const { page } = Astro.props;
const { locale } = page;
const c = windows[locale];
const tt = t(locale);
const origin = originOf(Astro.site);
const bc = trail(origin, locale, [{ name: tt.nav.windows, href: page.path }]);
const pieces = (await getProducts()).filter((p) => (p.data.category === 'windows' || p.data.category === 'heritage') && entryLocales(p.data).includes(locale));
const projects = (await getProjects()).filter((p) => p.data.filters.includes('windows') && entryLocales(p.data).includes(locale)).slice(0, 2);
const schema = [
  webPage(origin, locale, { url: bc.url, name: c.meta.title, description: c.meta.description, breadcrumbId: bc.id, mainEntity: { '@id': `${bc.url}#service` } }),
  bc.node,
  service(origin, locale, { url: bc.url, name: tt.categories.windows, description: c.meta.description, serviceType: tt.categories.windows }),
];
---
<Base locale={locale} pageType="windows" title={c.meta.title} description={c.meta.description} alternates={page.alternates}
  overlayHeader schema={schema} currentNav="windows" ogImage={heroImg} ogImageAlt={c.hero.imageAlt}>
  <Hero image={heroImg} alt={c.hero.imageAlt} eyebrow={c.hero.eyebrow} title={c.hero.title} lines={[c.hero.text]}>
    <div class="btn-row">
      <a class="btn btn--light" href={`${path(locale, 'start')}?type=windows`} data-track="start_project" data-track-location="windows_hero">{tt.cta.discussWindows}<Icon name="arrow" class="arrow" /></a>
    </div>
  </Hero>
  <Breadcrumbs locale={locale} items={bc.items} />

  <section class="section">
    <div class="container grid-2 grid-2--wide-right">
      <h2 class="h2 reveal">{c.intro.title}</h2>
      <div class="prose reveal">{c.intro.text.map((p) => <p class="lead">{p}</p>)}</div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="h-reasons">
    <div class="container">
      <SectionHead eyebrow={c.reasons.eyebrow} title={c.reasons.title} id="h-reasons" />
      <ul class="feature-list feature-list--2">
        {c.reasons.items.map((it) => <li class="reveal"><h3>{it.title}</h3><p>{it.text}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="h-craft">
    <div class="container grid-2 grid-2--start">
      <div class="sticky-col reveal">
        <SectionHead eyebrow={c.craft.eyebrow} title={c.craft.title} id="h-craft" />
        <div class="media media--4x5"><Img src={detailImg} alt="" ratio={4 / 5} sizes="(min-width: 900px) 40vw, 92vw" /></div>
      </div>
      <ul class="feature-list feature-list--stack">
        {c.craft.items.map((it) => <li class="reveal"><h3>{it.title}</h3><p>{it.text}</p></li>)}
      </ul>
    </div>
  </section>

  {pieces.length > 0 && (
    <section class="section section--alt" aria-labelledby="h-pieces">
      <div class="container">
        <SectionHead eyebrow={c.pieces.eyebrow} title={c.pieces.title} id="h-pieces" />
        <div class="cards-3">{pieces.map((p, i) => <ProductCard entry={p} locale={locale} index={i} list="windows_page" />)}</div>
      </div>
    </section>
  )}

  {projects.length > 0 && (
    <section class="section" aria-labelledby="h-wprojects">
      <div class="container">
        <SectionHead eyebrow={c.projects.eyebrow} title={c.projects.title} id="h-wprojects" />
        <div class="two-col">{projects.map((p) => <ProjectCard entry={p} locale={locale} />)}</div>
      </div>
    </section>
  )}

  <CtaBand locale={locale} title={c.cta.title} text={c.cta.text} cta={tt.cta.discussWindows} projectType="windows" location="windows_closing" />
</Base>
<style>
  .feature-list--stack > li { grid-template-columns: 1fr !important; }
  @media (min-width: 900px) { .sticky-col { position: sticky; top: calc(var(--header-h) + 32px); } }
</style>
